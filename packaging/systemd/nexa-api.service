[Unit]
Description=Nexa Panel control plane
Documentation=https://github.com/nexa-panel/nexa-panel
After=network-online.target nexa-agent.service
Wants=network-online.target
Requires=nexa-agent.service

[Service]
Type=simple
User=nexa
Group=nexa
UMask=0077
Environment=NEXA_AGENT_SOCKET=/run/nexa-panel/agent.sock
LoadCredential=agent.token:/etc/nexa-panel/agent.token
ExecStart=/usr/bin/nexa api --unix-socket /run/nexa-panel/api.sock --state /var/lib/nexa-panel/control.db --master-key /var/lib/nexa-panel/master.key --agent-token %d/agent.token
Restart=on-failure
RestartSec=3s
StateDirectory=nexa-panel
StateDirectoryMode=0700
LogsDirectory=nexa-panel
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
KeyringMode=private
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
