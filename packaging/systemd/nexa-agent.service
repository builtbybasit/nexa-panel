[Unit]
Description=Nexa Panel privileged node agent
Documentation=https://github.com/nexa-panel/nexa-panel
After=local-fs.target network.target
Before=nexa-api.service

[Service]
Type=simple
User=root
Group=nexa
UMask=0177
ExecStartPre=/usr/bin/nexa agent-token --path /etc/nexa-panel/agent.token
ExecStart=/usr/bin/nexa agent --socket /run/nexa-panel/agent.sock --token /etc/nexa-panel/agent.token --probe-path /etc/nexa-panel/probe.conf
Restart=on-failure
RestartSec=3s
ConfigurationDirectory=nexa-panel
ConfigurationDirectoryMode=0711
NoNewPrivileges=true
PrivateTmp=true
# Package and service operators need these host trees writable. Everything else
# remains read-only inside the agent's mount namespace.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/boot /etc /opt /srv /usr /var /run/containers /run/nexa-panel /run/php /run/postgresql
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
KeyringMode=private
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
