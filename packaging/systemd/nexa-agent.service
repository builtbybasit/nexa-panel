[Unit]
Description=Nexa Panel privileged node agent
Documentation=https://github.com/nexa-panel/nexa-panel
After=local-fs.target network.target
Before=nexa-api.service
# Same budget as the control plane: ten restarts at RestartSec=3s ride out a
# transient boot-order or socket-teardown flap, and a genuine crash loop stops
# rather than restarting the privileged agent forever.
StartLimitIntervalSec=300s
StartLimitBurst=10

[Service]
Type=simple
# Deliberately no User=. The agent runs as root either way — that is systemd's
# default — but naming the user explicitly makes systemd withhold CAP_SETUID
# from the permitted set once NoNewPrivileges= is also set. apt's http and https
# methods seteuid to _apt (uid 42) before they fetch anything, so with User=root
# every download failed with "E: seteuid 42 failed" and no application, PHP
# extension or database engine could be installed from the panel at all. The
# sandbox is otherwise unchanged: Group=, NoNewPrivileges= and every Protect*
# below still apply.
Group=nexa
UMask=0177
Environment=NEXA_LOG_LEVEL=info
ExecStartPre=/usr/bin/nexa agent-token --path /etc/nexa-panel/agent.token
ExecStart=/usr/bin/nexa agent --socket /run/nexa-panel/agent.sock --token /etc/nexa-panel/agent.token
Restart=on-failure
RestartSec=3s
# No ConfigurationDirectory=: it would make systemd own /etc/nexa-panel and
# chown it to this unit's root:nexa, overwriting the root:root 0711 tmpfiles
# contract that the admin-tool subdirectories (owned by the phpMyAdmin and
# pgAdmin uids) and the root-executed generated/ tree depend on. The agent runs
# as root with /etc already in ReadWritePaths, so it gains nothing here.
# apt, dpkg and podman run inside this cgroup, so the ceiling has to clear their
# real peaks: an unpack plus a container image pull sits in the low hundreds of
# megabytes. 1G soft-throttles into reclaim before the node starts swapping,
# 1536M leaves a 2 GiB host (capacity.ProfileCompact, the advertised minimum)
# room for the kernel and the control plane while still killing a runaway.
MemoryHigh=1G
MemoryMax=1536M
# Two cores' worth: dpkg unpacking and image builds stay responsive on a
# multi-core VPS without the agent monopolising a busy node.
CPUQuota=200%
TasksMax=4096
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
# Package and service operators need these host trees writable. Everything else
# remains read-only inside the agent's mount namespace.
ProtectSystem=strict
ProtectHome=true
# The /run paths a package creates only once its service has run are prefixed
# with '-' so a missing one is skipped instead of failing the mount namespace.
# Without that, the first boot after a reboot died with 226/NAMESPACE because
# /run/containers does not exist until Podman has started, and nexa-api then
# failed permanently with 'dependency' while the agent recovered on its own.
ReadWritePaths=/boot /etc /opt /srv /usr /var -/run/containers /run/nexa-panel -/run/php -/run/postgresql
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true
KeyringMode=private
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
