[Unit]
Description=Nexa Panel privileged node agent
Documentation=https://github.com/nexa-panel/nexa-panel
After=local-fs.target network.target
Before=nexa-api.service

[Service]
Type=simple
User=root
Group=nexa
UMask=0007
ExecStart=/usr/bin/nexa agent --socket /run/nexa-panel/agent.sock --token /etc/nexa-panel/agent.token --probe-path /etc/nexa-panel/probe.conf
Restart=on-failure
RestartSec=3s
RuntimeDirectory=nexa-panel
RuntimeDirectoryMode=0750
StateDirectory=nexa-panel
StateDirectoryMode=0750
ConfigurationDirectory=nexa-panel
ConfigurationDirectoryMode=0750
LogsDirectory=nexa-panel
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/nexa-panel /etc/containers/systemd /etc/cron.d /etc/systemd/system /etc/nginx /etc/php /etc/postgresql /etc/letsencrypt /etc/passwd /etc/shadow /etc/group /etc/gshadow /srv/nexa /var/lib/nexa-panel /var/lib/postgresql /var/lib/letsencrypt /var/log/postgresql /var/log/letsencrypt /run/nexa-panel /run/php /run/postgresql
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
