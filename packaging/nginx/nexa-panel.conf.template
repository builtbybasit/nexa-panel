server {
    listen __LISTEN__;
    server_name __SERVER_NAME__;

    # File uploads are chunked at 8 MiB by the API. A small margin covers HTTP
    # framing without allowing a reverse-proxy worker to spool multi-gigabyte
    # request bodies that the application will reject.
    client_max_body_size 10m;
    client_body_timeout 5m;

    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://unix:/run/nexa-panel/api.sock;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://unix:/run/nexa-panel/api.sock;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_send_timeout 5m;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }
}
