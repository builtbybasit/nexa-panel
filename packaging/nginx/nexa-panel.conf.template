# Rate-limit zones. limit_req_zone is only valid at http{} scope — NOT inside a
# server{} block. If this file is included directly under http{} (the default for
# /etc/nginx/conf.d/*.conf and sites-enabled/*), these two lines load correctly
# as written. If your install instead pulls this file INSIDE a server{} block,
# move these two limit_req_zone directives up to the http{} context (e.g. a
# snippet in /etc/nginx/conf.d/) and leave only the limit_req lines below.
#
#   - nexa_auth:  credential-submitting endpoints (login/bootstrap/mfa). ~10 req
#     per minute per client IP; burst 5 absorbs a legitimate operator's retries.
#   - nexa_api:   whole-panel flood backstop. 20 req/s per client IP with a wide
#     burst so normal SPA traffic (many small XHRs) is never throttled.
#
# Keyed on $binary_remote_addr — the direct peer. nginx terminates the public
# connection, so this is the real client; the app applies its own IP throttle
# behind this using the forwarded address as defense-in-depth.
limit_req_zone $binary_remote_addr zone=nexa_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=nexa_api:10m rate=20r/s;

server {
    listen __LISTEN__;
    server_name __SERVER_NAME__;

    # Return 429 (not the nginx default 503) when a client exceeds its budget, so
    # callers and the SPA can distinguish rate limiting from an outage.
    limit_req_status 429;

    # File uploads are chunked at 8 MiB by the API. A small margin covers HTTP
    # framing without allowing a reverse-proxy worker to spool multi-gigabyte
    # request bodies that the application will reject.
    client_max_body_size 10m;
    client_body_timeout 5m;

    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://unix:/run/nexa-panel/api.sock;
        proxy_set_header Host $http_host;
    }

    # Credential-testing surface: login, bootstrap, and every MFA step. The tight
    # per-IP budget defeats password spraying across unlimited usernames from one
    # host; burst 5 nodelay lets a real operator mistype and retry without waiting.
    location /api/v1/auth/ {
        limit_req zone=nexa_auth burst=5 nodelay;

        proxy_pass http://unix:/run/nexa-panel/api.sock;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_send_timeout 5m;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        # General flood backstop. The wide burst absorbs the many small XHRs a
        # normal page load fires; only sustained automated flooding trips it.
        limit_req zone=nexa_api burst=100 nodelay;

        proxy_pass http://unix:/run/nexa-panel/api.sock;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_send_timeout 5m;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;
    }
}
